<?xml version="1.0" encoding="utf-8"?>
<!-- The app only ever talks to github.com and api.github.com, over HTTPS. Plain HTTP is refused everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
